# /etc/tgstream/tgstream.env  (root:tgstream 640)
# Lo lee systemd (EnvironmentFile) y bin/run.sh cuando se corre a mano.
# OJO: systemd no acepta comentarios al final de una línea; van en su propia línea.

# Telegram: crear story → Live → ⚙️ → Connect Stream
RTMP_URL="rtmps://dcX-1.rtmp.t.me/s/"
RTMP_KEY=""

# Página a transmitir (ejemplo: el modo stream de cambiocup.com)
PAGE_URL="https://www.cambiocup.com/?stream=true"

# Render / video. Valores probados: no cambiar sin medir (ver README)
SCALE=2
FPS=60
# Bitrates siempre en k
VIDEO_BITRATE=5000k
AUDIO_BITRATE=160k

# Música. MUSIC_LUFS: -14 más alto, -20 más bajo
MUSIC_DIR=/srv/tgstream/music
MUSIC_LUFS=-16

# Reels (opcional): cada REELS_EVERY segundos pone un video al azar de REELS_DIR,
# a pantalla completa y sin su audio (la música sigue). Sin REELS_DIR no hay reels.
#REELS_DIR=/srv/tgstream/reels
REELS_EVERY=600
REELS_MAX=60

# Avanzado: solo si corres más de un stream en el mismo server
DISPLAY_NUM=99
CDP_PORT=9222
