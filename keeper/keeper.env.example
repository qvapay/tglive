# /etc/tgstream/keeper.env  (root:tgstream 640)
# OJO: systemd no acepta comentarios al final de una línea.

# De https://my.telegram.org → API development tools (con la cuenta dueña del live)
TG_API_ID=
TG_API_HASH=

# Dónde va el live: @canal (tu cuenta tiene que ser admin con permiso de stories) o me
TG_PEER=@tu_canal

# Archivo de sesión: da acceso total a la cuenta. No lo muevas fuera de /var/lib/tgstream-keeper
TG_SESSION=/var/lib/tgstream-keeper/keeper

# public o close_friends (en canales Telegram lo ignora: lo ve quien siga el canal)
TG_PRIVACY=public

# Cada cuántos segundos comprobar si el live sigue vivo
CHECK_INTERVAL=30

# Segundos antes del expire_date para rotar el live (terminar + crear). Telegram lo cierra a las 4 h. 0 = no rotar
ROTATE_BEFORE_EXPIRE=120

# Servicio a reiniciar cuando se crea un live nuevo (vacío = no reiniciar)
STREAM_SERVICE=tgstream.service

# saved = avisar en tus Mensajes guardados cuando recrea el live o hay errores; off = no avisar
NOTIFY=saved
